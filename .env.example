# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram and get your token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Chat ID to receive alerts. Use your GROUP id (negative, e.g. -1001234567890),
# not your personal user id. Comma-separate for multiple: -1001234567890,987654321
# Find ids: python scripts/get_telegram_chat_id.py  (mention bot in group first)
TELEGRAM_CHAT_ID=your_telegram_group_chat_id_here

# Optional: Set to "false" to disable Telegram alerts
ENABLE_TELEGRAM=true

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (for intraday group alerts)
# Setup: https://developers.facebook.com → Create App → Add WhatsApp product
# ---------------------------------------------------------------------------

# Permanent access token from Meta Developer Console
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Phone Number ID from WhatsApp → API Setup page
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp GROUP JID (ends with @g.us) — your business number must be in the group
# Example: 120363012345678912@g.us
WHATSAPP_GROUP_ID=your_whatsapp_group_id_here

# Alternative: send to a single number instead of group (country code, no +)
# WHATSAPP_TO=919876543210

# Optional: Set to "false" to disable WhatsApp alerts
ENABLE_WHATSAPP=true

# Optional: Meta API version (default v21.0)
WHATSAPP_API_VERSION=v21.0

# ---------------------------------------------------------------------------
# App settings
# ---------------------------------------------------------------------------

# Optional: Streamlit dashboard port (default 8501)
DASHBOARD_PORT=8501

# Optional: Number of top stocks to show (default 5)
TOP_N_STOCKS=5

# Optional: Default intraday candle interval — 15m
INTRADAY_INTERVAL=15m

# ---------------------------------------------------------------------------
# Dashboard login (email OTP)
# ---------------------------------------------------------------------------

# Optional legacy fallback — emails can also be managed from the Admin page
# ALLOWED_EMAILS=you@example.com

# Admin is mjworkplace2023@gmail.com (set in data/dashboard_users.json on first run)

# SMTP settings for sending OTP emails (Gmail example below)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_USE_TLS=true

# OTP valid for 10 minutes; dashboard session lasts 60 minutes
OTP_VALID_MINUTES=3
SESSION_DURATION_MINUTES=60
OTP_RESEND_SECONDS=60
